{
  "colors": {
    "blue": {
      "500": { "$value": "#3b82f6", "$type": "color" },
      "600": { "$value": "#2563eb", "$type": "color" }
    },
    "white": { "$value": "#ffffff", "$type": "color" }
  },
  "color": {
    "background": {
      "primary": {
        "default": {
          "$value": "{colors.blue.600}",
          "$type": "color",
          "useFor": "Haupt-Aktion in einem Flow, primärer CTA",
          "avoidFor": "dekorative Flächen, sekundäre/tertiäre Aktionen"
        },
        "hover": { "$value": "{colors.blue.600}", "$type": "color" }
      }
    },
    "text": {
      "primary": {
        "default": { "$value": "{colors.white}", "$type": "color" }
      }
    },
    "border": {
      "primary": {
        "default": { "$value": "{colors.blue.500}", "$type": "color" }
      }
    }
  },
  "space": {
    "component": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" }
    }
  },
  "radii": {
    "md": { "$value": "6px", "$type": "dimension" }
  },
  "font": {
    "size": { "md": { "$value": "14px", "$type": "dimension" } },
    "weight": { "medium": { "$value": 500, "$type": "number" } },
    "lineHeight": { "md": { "$value": "20px", "$type": "dimension" } },
    "family": {
      "base": {
        "$value": "Geist Variable",
        "$type": "fontFamily",
        "useFor": "CSS-Wert fuer den Web-Code. Figma kennt denselben Font unter dem Namen \"Geist\" (ohne \"Variable\"-Suffix) -- dafuer existiert eine eigene, separat gepflegte Figma-Variable, kein gemeinsamer Sync-Wert moeglich."
      }
    }
  }
}
