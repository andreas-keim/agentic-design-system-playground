{
  "colors": {
    "blue": {
      "500": { "$value": "#3b82f6", "$type": "color" },
      "600": { "$value": "#2563eb", "$type": "color" },
      "700": { "$value": "#1d4ed8", "$type": "color" }
    },
    "red": {
      "700": { "$value": "#b91c1c", "$type": "color" }
    },
    "white": { "$value": "#ffffff", "$type": "color" }
  },
  "color": {
    "background": {
      "primary": {
        "default": {
          "$value": "{colors.blue.600}",
          "$type": "color",
          "useFor": "Haupt-Aktion in einem Flow, primärer CTA",
          "avoidFor": "dekorative Flächen, sekundäre/tertiäre Aktionen"
        },
        "hover": { "$value": "{colors.blue.700}", "$type": "color" }
      }
    },
    "text": {
      "primary": {
        "default": { "$value": "{colors.white}", "$type": "color" }
      },
      "destructive": {
        "default": {
          "$value": "{colors.red.700}",
          "$type": "color",
          "useFor": "Text auf dem getönten Destructive-Button-Hintergrund (bg-destructive/10) — heller als shadcns eigenes --destructive, weil sonst der Kontrast gegen den Tint-Hintergrund unter 4.5:1 faellt (siehe ACCESSIBILITY.md)",
          "avoidFor": "Text auf einem vollflächigen/soliden roten Hintergrund — dort ist shadcns --destructive-foreground (weiss) korrekt, nicht dieses Token"
        }
      }
    },
    "border": {
      "primary": {
        "default": { "$value": "{colors.blue.500}", "$type": "color" }
      }
    }
  },
  "space": {
    "component": {
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" }
    }
  },
  "radii": {
    "md": { "$value": "6px", "$type": "dimension" }
  },
  "font": {
    "size": {
      "md": { "$value": "14px", "$type": "dimension" },
      "xl": {
        "$value": "24px",
        "$type": "dimension",
        "useFor": "Headline/Seitentitel (z.B. \"Welcome back\" auf einer Login-Seite)",
        "avoidFor": "Fließtext, Labels, Button-Text -- dafuer font.size.md"
      }
    },
    "weight": {
      "medium": { "$value": 500, "$type": "number" },
      "bold": {
        "$value": 700,
        "$type": "number",
        "useFor": "Headline, zusammen mit font.size.xl",
        "avoidFor": "Fließtext/Subtext -- dafuer kein Weight-Token setzen, Default (400) reicht"
      }
    },
    "lineHeight": {
      "md": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "32px", "$type": "dimension", "useFor": "zusammen mit font.size.xl" }
    },
    "family": {
      "base": {
        "$value": "Geist Variable",
        "$type": "fontFamily",
        "useFor": "CSS-Wert fuer den Web-Code. Figma kennt denselben Font unter dem Namen \"Geist\" (ohne \"Variable\"-Suffix) -- dafuer existiert eine eigene, separat gepflegte Figma-Variable, kein gemeinsamer Sync-Wert moeglich."
      }
    }
  }
}
